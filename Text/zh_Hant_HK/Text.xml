		<Row Tag="LOC_DIPLO_AI_REFUSE_DEMAND_LEADER_HOLOX_SAKAMATA_CHLOE_ANY" Language="zh_Hant_HK">
			<Text>不要不要不要！絕對不給你！</Text>
